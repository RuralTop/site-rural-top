# URL pública do site (usada em SEO: canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.ruraltop.com.br

# Número de WhatsApp comercial, com DDI+DDD, apenas dígitos (ex.: 5561996324385)
NEXT_PUBLIC_WHATSAPP_NUMBER=5561996324385

# Opcional: ID do Google Analytics / GTM, quando configurado
# NEXT_PUBLIC_GA_ID=

# Notificação por e-mail de novas solicitações do formulário de contato (opcional).
# Sem essas variáveis, o formulário continua funcionando normalmente só pelo WhatsApp.
# Crie uma conta gratuita em https://resend.com para gerar a API key.
RESEND_API_KEY=
CONTACT_EMAIL_TO=contato@ruraltop.com.br
# Remetente do e-mail. Sem domínio verificado no Resend, use o padrão abaixo;
# depois de verificar um domínio próprio no Resend, troque para um endereço @ruraltop.com.br.
# RESEND_FROM_EMAIL=Rural Top <onboarding@resend.dev>
